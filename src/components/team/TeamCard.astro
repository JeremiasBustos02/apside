---
interface Props {
	id: string;
	name: string;
	role: string;
	photo?: string;
}

const { id, name, role, photo } = Astro.props;

const initials = name
	.split(" ")
	.map((part) => part[0])
	.join("");
---

<button
	type="button"
	data-team-open={id}
	data-team-card
	aria-label={`Ver perfil de ${name}`}
	class="group flex w-full cursor-pointer flex-col items-center gap-3 rounded-card border border-soft bg-white p-card pb-6 pt-card text-center shadow-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent hover:border-primary/30 hover:shadow-md"
>
	{photo ? (
		<img
			src={photo}
			alt=""
			width={80}
			height={80}
			loading="lazy"
			class="size-20 rounded-full object-cover"
		/>
	) : (
		<div
			class="flex size-20 items-center justify-center rounded-full bg-soft font-display text-h4 text-primary"
			aria-hidden="true"
		>
			{initials}
		</div>
	)}
	<div class="flex flex-col items-center gap-1">
		<h3 class="font-display text-h4 text-ink">{name}</h3>
		<p class="text-small text-ink/70">{role}</p>
	</div>
</button>