---
interface Props {
	id: string;
	name: string;
	role: string;
	photo?: string;
	traits: string[];
}

const { id, name, role, photo, traits } = Astro.props;

const initials = name
	.split(" ")
	.map((part) => part[0])
	.join("");
---

<button
	type="button"
	data-team-open={id}
	aria-label={`Ver perfil de ${name}`}
	class="group flex w-full flex-col items-center gap-4 rounded-card border border-soft bg-white p-card text-center shadow-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent hover:border-primary/30 hover:shadow-md"
>
	{photo ? (
		<img
			src={photo}
			alt=""
			width={96}
			height={96}
			loading="lazy"
			class="size-24 rounded-full object-cover"
		/>
	) : (
		<div
			class="flex size-24 items-center justify-center rounded-full bg-soft font-display text-h3 text-primary"
			aria-hidden="true"
		>
			{initials}
		</div>
	)}
	<div class="flex flex-col items-center gap-1">
		<h3 class="font-display text-h4 text-ink">{name}</h3>
		<p class="text-small text-ink/70">{role}</p>
	</div>
	<div class="flex flex-wrap justify-center gap-tight">
		{traits.map((trait) => (
			<span class="rounded-pill bg-secondary/15 px-3 py-1 text-caption text-secondary">
				{trait}
			</span>
		))}
	</div>
</button>