---
interface Props {
	title: string;
	summary: string;
	forWhom: string;
	problem: string;
	improves: string;
}

const { title, summary, forWhom, problem, improves } = Astro.props;
---

<article
	data-service-card
	class="group flex flex-col gap-4 overflow-hidden rounded-card border border-soft bg-white p-card shadow-sm transition-all focus-within:border-primary/30 hover:border-primary/30 hover:shadow-md"
>
	<div class="flex flex-col gap-2">
		<h3 class="font-display font-bold text-h4 text-ink">{title}</h3>
		<p class="text-small text-ink/70">{summary}</p>
	</div>

	<div
		class="grid grid-rows-[0fr] transition-all duration-500 ease-out group-open:grid-rows-[1fr]"
	>
		<div class="overflow-hidden">
			<div class="flex flex-col gap-4 border-t border-soft pt-4">
				<p class="text-small text-ink/70">
					<span class="font-semibold text-primary">Para quién: </span>
					{forWhom}
				</p>
				<p class="text-small text-ink/70">
					<span class="font-semibold text-primary">Problema que resuelve: </span>
					{problem}
				</p>
			</div>
		</div>
	</div>

	<div
		class="mt-auto flex items-center justify-between gap-4 border-t border-soft pt-4"
	>
		<button
			type="button"
			data-service-toggle
			aria-expanded="false"
			class="flex shrink-0 cursor-pointer items-center gap-2 text-small font-semibold text-primary"
		>
			<span data-service-label class="whitespace-nowrap">Ver detalles</span>
			<svg
				class="h-4 w-4 transition-transform duration-300 group-open:rotate-180"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2.5"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="m6 9 6 6 6-6" />
			</svg>
		</button>
	</div>
</article>

<script>
	const cards = Array.from(
		document.querySelectorAll<HTMLElement>("[data-service-card]"),
	);

	const apply = (card: HTMLElement, open: boolean) => {
		card.toggleAttribute("open", open);
		card
			.querySelector<HTMLButtonElement>("[data-service-toggle]")
			?.setAttribute("aria-expanded", String(open));
		const label = card.querySelector<HTMLElement>("[data-service-label]");
		if (label) label.textContent = open ? "Ocultar" : "Ver detalles";
	};

	cards.forEach((card) => {
		const toggle = card.querySelector<HTMLButtonElement>(
			"[data-service-toggle]",
		);

		const onClick = () => {
			if (card.hasAttribute("open")) {
				apply(card, false);
			} else {
				cards.forEach((other) => apply(other, false));
				apply(card, true);
			}
		};

		toggle?.addEventListener("click", (event) => {
			event.stopPropagation();
			onClick();
		});
		card.addEventListener("click", onClick);
	});
</script>