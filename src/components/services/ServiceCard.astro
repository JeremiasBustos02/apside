---
interface Props {
	title: string;
	summary: string;
	forWhom: string;
	problem: string;
	includes: string[];
	improves: string;
}

const { title, summary, forWhom, problem, includes, improves } =
	Astro.props;
---

<article
	class="flex flex-col gap-5 rounded-card border border-soft bg-white p-card shadow-sm"
>
	<div class="flex flex-col gap-2">
		<h3 class="font-display text-h4 text-ink">{title}</h3>
		<p class="text-small text-primary">{summary}</p>
	</div>

	<div class="flex flex-col gap-4">
		<div class="rounded-lg border-l-4 border-primary bg-soft/50 px-4 py-3">
			<p class="text-caption font-semibold uppercase tracking-widest text-primary">
				Para quién
			</p>
			<p class="mt-1 text-body text-ink/80">{forWhom}</p>
		</div>

		<div class="rounded-lg border-l-4 border-accent bg-white px-4 py-3">
			<p class="text-caption font-semibold uppercase tracking-widest text-accent">
				El problema
			</p>
			<p class="mt-1 text-body italic text-ink/70">{problem}</p>
		</div>

		<div>
			<p class="text-caption font-semibold uppercase tracking-widest text-ink/60">
				Qué incluye
			</p>
			<ul class="mt-3 flex flex-wrap gap-2">
				{includes.map((item) => (
					<li
						class="rounded-pill bg-secondary/10 px-3 py-1 text-caption text-secondary"
					>
						{item}
					</li>
				))}
			</ul>
		</div>

		<div class="border-t border-soft pt-4">
			<p class="text-caption font-semibold uppercase tracking-widest text-ink/60">
				Lo que mejora
			</p>
			<p class="mt-1 font-medium text-primary">{improves}</p>
		</div>
	</div>
</article>