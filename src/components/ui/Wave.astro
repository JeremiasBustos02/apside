---
interface Props {
	color?: "white" | "soft" | "primary" | "secondary" | "ink";
	flip?: boolean;
	class?: string;
}

const { color = "soft", flip = false, class: className = "" } = Astro.props;

const colorClasses = {
	white: "text-white",
	soft: "text-soft",
	primary: "text-primary",
	secondary: "text-secondary",
	ink: "text-ink",
} as const;
---

<svg
	class:list={[flip && "rotate-180", colorClasses[color], className]}
	viewBox="0 0 1440 120"
	xmlns="http://www.w3.org/2000/svg"
	preserveAspectRatio="none"
	width="100%"
	height={120}
	aria-hidden="true"
	fill="currentColor"
>
	<path d="M0 64C120 8 240 20 360 64C480 108 600 112 720 96C840 80 960 40 1080 32C1200 24 1320 56 1440 48V120H0V64Z" />
</svg>