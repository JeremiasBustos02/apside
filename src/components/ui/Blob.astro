---
interface Props {
	color?: "primary" | "secondary" | "accent" | "soft" | "ink";
	size?: number;
	position?: string;
	class?: string;
}

const {
	color = "primary",
	size = 320,
	position = "",
	class: className = "",
} = Astro.props;

const colorClasses = {
	primary: "text-primary",
	secondary: "text-secondary",
	accent: "text-accent",
	soft: "text-soft",
	ink: "text-ink",
} as const;
---

<div
	class:list={[position, className]}
	aria-hidden="true"
	style={{ width: `${size}px`, height: `${size}px` }}
>
	<svg
		viewBox="0 0 200 200"
		xmlns="http://www.w3.org/2000/svg"
		class:list={[colorClasses[color]]}
		width="100%"
		height="100%"
		fill="currentColor"
	>
		<path
			d="M52.2 12.3C74.2 -0.6 102.7 -2.4 123.6 8.9C144.5 20.2 158.9 44.1 162.5 67.7C166.1 91.3 158.3 117.1 142.2 133.6C126.1 150.1 101.5 158.6 77.2 153.4C52.9 148.2 27.5 134.3 17.1 113.6C6.7 92.9 6.4 62.8 18.2 42.5C30 22.2 43.1 13.4 52.2 12.3Z"
		/>
	</svg>
</div>