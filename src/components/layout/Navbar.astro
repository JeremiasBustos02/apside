---
const navLinks = [
	{ label: "Servicios", href: "#servicios" },
	{ label: "Proceso", href: "#proceso" },
	{ label: "Equipo", href: "#equipo" },
	{ label: "Contacto", href: "#contacto" },
];
---

<header
	data-nav
	class="fixed inset-x-0 top-0 z-50 transition-all duration-300"
>
	<div
		data-nav-inner
		class="transition-[width,max-width,margin,border-radius,box-shadow] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)]"
	>
		<nav
			aria-label="Navegación principal"
			class="container-apside flex items-center justify-between gap-6 py-4 transition-[padding] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)]"
		>
			<a
				href="#hero"
				class="nav-brand whitespace-nowrap font-brand text-h3 text-soft transition-colors"
			>
				Apside
			</a>

			<ul
				class="nav-links hidden flex-1 items-center justify-center gap-8 md:flex"
			>
				{navLinks.map((link) => (
					<li>
						<a
							href={link.href}
							class="nav-link font-sans text-small font-medium text-soft/80 transition-colors hover:text-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
						>
							{link.label}
						</a>
					</li>
				))}
			</ul>

			<a
				href="#contacto"
				class="hidden items-center gap-2 rounded-sm bg-primary px-5 py-2.5 text-small font-medium text-white transition-colors hover:bg-primary/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:inline-flex"
			>
				Contactanos
				<svg
					width="14"
					height="14"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M5 12h14" />
					<path d="m12 5 7 7-7 7" />
				</svg>
			</a>

			<button
				type="button"
				class="nav-toggle md:hidden"
				data-nav-toggle
				aria-expanded="false"
				aria-controls="mobile-nav"
				aria-label="Abrir menú"
			>
				<svg viewBox="0 0 24 24" width="26" height="26" fill="none" aria-hidden="true" data-nav-icon-open>
					<path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="text-soft" />
				</svg>
				<svg viewBox="0 0 24 24" width="26" height="26" fill="none" aria-hidden="true" data-nav-icon-close class="hidden">
					<path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="text-soft" />
				</svg>
			</button>
		</nav>
	</div>

	<div id="mobile-nav" data-mobile-nav class="container-apside hidden md:hidden">
		<ul class="flex flex-col gap-5 px-gutter pb-6 pt-4">
			{navLinks.map((link) => (
				<li>
					<a
						href={link.href}
						class="font-sans text-body font-medium text-soft/85 transition-colors hover:text-white"
					>
						{link.label}
					</a>
				</li>
			))}
		</ul>
	</div>
</header>

<style>
	:global([data-nav-inner]) {
		background-color: rgba(9, 24, 33, 0.92);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		border-radius: 0;
	}
	:global([data-mobile-nav]) {
		background-color: rgba(9, 24, 33, 0.92);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		border-radius: 0 0 1rem 1rem;
	}
	:global(header[data-nav-scrolled]) {
		display: flex;
		flex-direction: column;
	}
	:global(header[data-nav-scrolled] [data-mobile-nav]) {
		width: calc(100% - 3rem);
		max-width: calc(var(--max-w-content) - 3rem);
		margin-inline: auto;
	}
	@media (min-width: 40rem) {
		:global(header[data-nav-scrolled] [data-mobile-nav]) {
			width: calc(100% - 5rem);
			max-width: calc(var(--max-w-content) - 5rem);
		}
	}
	@media (min-width: 64rem) {
		:global(header[data-nav-scrolled] [data-mobile-nav]) {
			width: calc(100% - 12rem);
			max-width: calc(var(--max-w-content) - 12rem);
		}
	}
	:global(header[data-nav-scrolled][data-nav-open] [data-nav-inner]) {
		border-radius: 1rem 1rem 0 0;
	}
	:global(header[data-nav-scrolled] [data-nav-inner]) {
		border-radius: 1rem;
		width: calc(100% - 3rem);
		max-width: calc(var(--max-w-content) - 3rem);
		margin-top: 1.25rem;
		margin-inline: auto;
		box-shadow: 0 10px 30px -12px rgba(9, 24, 33, 0.45);
	}
	@media (min-width: 40rem) {
		:global(header[data-nav-scrolled] [data-nav-inner]) {
			width: calc(100% - 5rem);
			max-width: calc(var(--max-w-content) - 5rem);
		}
	}
	@media (min-width: 64rem) {
		:global(header[data-nav-scrolled] [data-nav-inner]) {
			width: calc(100% - 12rem);
			max-width: calc(var(--max-w-content) - 12rem);
		}
	}
	:global(header[data-nav-scrolled] [data-nav-inner] nav) {
		padding: 0.75rem 1.25rem;
	}
</style>

<script>
	const header = document.querySelector("[data-nav]");
	const toggle = document.querySelector("[data-nav-toggle]");
	const nav = document.querySelector("[data-mobile-nav]");
	const iconOpen = document.querySelector("[data-nav-icon-open]");
	const iconClose = document.querySelector("[data-nav-icon-close]");

	const onScroll = () => {
		if (!header) return;
		const scrolled = window.scrollY > 24;
		if (scrolled) {
			header.setAttribute("data-nav-scrolled", "");
		} else {
			header.removeAttribute("data-nav-scrolled");
		}
	};
	onScroll();
	window.addEventListener("scroll", onScroll, { passive: true });

	if (toggle && nav && iconOpen && iconClose) {
		const setExpanded = (expanded) => {
			toggle.setAttribute("aria-expanded", String(expanded));
			toggle.setAttribute(
				"aria-label",
				expanded ? "Cerrar menú" : "Abrir menú",
			);
			header?.toggleAttribute("data-nav-open", expanded);
			nav.classList.toggle("hidden", !expanded);
			iconOpen.classList.toggle("hidden", expanded);
			iconClose.classList.toggle("hidden", !expanded);
		};

		toggle.addEventListener("click", () => {
			setExpanded(toggle.getAttribute("aria-expanded") !== "true");
		});

		nav.querySelectorAll("a").forEach((link) => {
			link.addEventListener("click", () => setExpanded(false));
		});
	}
</script>