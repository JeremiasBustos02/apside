---
import { getCollection } from "astro:content";
import SectionTitle from "../ui/SectionTitle.astro";
import Wave from "../ui/Wave.astro";
import Timeline from "../process/Timeline.astro";

const steps = (await getCollection("process")).sort(
	(a, b) => a.data.step - b.data.step,
);
---

<section id="proceso" class="relative scroll-mt-24 bg-white">
	<div class="container-apside pt-section">
		<SectionTitle
			title="Nuestro proceso"
			subtitle="Un camino claro de la idea al resultado"
			align="center"
		/>
	</div>

	<div id="process-stage" class="relative mt-block pb-[9rem]">
		<div class="container-apside">
			<Timeline steps={steps.map((s) => s.data)} />
		</div>
	</div>

	<Wave color="soft" class="absolute inset-x-0 bottom-0" />
</section>