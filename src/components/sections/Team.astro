---
import { getCollection, render } from "astro:content";
import SectionTitle from "../ui/SectionTitle.astro";
import Wave from "../ui/Wave.astro";
import Blob from "../ui/Blob.astro";
import TeamCard from "../team/TeamCard.astro";
import TeamModal from "../team/TeamModal.astro";

const teamMembers = (await getCollection("team")).sort(
	(a, b) => a.data.order - b.data.order
);

const renderedModals = await Promise.all(
	teamMembers.map(async (member) => {
		const { Content } = await render(member);
		return { member, Content };
	})
);
---

<section
	id="equipo"
	class="relative scroll-mt-24 bg-ink"
>
	<Blob
		color="secondary"
		size={260}
		class="absolute -left-24 top-1/4 opacity-10"
		parallax={0.4}
	/>
	<Blob
		color="primary"
		size={200}
		class="absolute -right-20 bottom-1/4 opacity-10"
		parallax={0.6}
	/>
	<div class="container-apside relative pb-section pt-section">
		<SectionTitle
			title="Equipo"
			subtitle="El equipo detrás de Apside"
			align="left"
			tone="light"
		/>
		<div class="mt-gutter grid grid-cols-1 gap-card sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
			{teamMembers.map((member) => (
				<TeamCard
					id={member.id}
					name={member.data.name}
					role={member.data.role}
					photo={member.data.photo}
				/>
			))}
		</div>
	</div>

	{renderedModals.map(({ member, Content }) => (
		<TeamModal
			id={member.id}
			name={member.data.name}
			role={member.data.role}
			photo={member.data.photo}
			joinedYear={member.data.joinedYear}
		>
			<Content />
		</TeamModal>
	))}

	<Wave
		color="white"
		class="absolute inset-x-0 bottom-9 h-12 -scale-x-100 opacity-5"
	/>
	<Wave
		color="white"
		class="absolute inset-x-0 -bottom-3 h-12 -scale-y-100 opacity-5"
	/>
</section>