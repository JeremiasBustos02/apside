---
import { hero } from "../../content/sections/hero";
import Blob from "../ui/Blob.astro";
import DecorativeCircle from "../ui/DecorativeCircle.astro";
---

<section id="hero" class="relative flex scroll-mt-24 items-center overflow-hidden bg-white">
	<Blob
		color="soft"
		size={420}
		position="absolute -left-32 -top-24 -z-10"
		class="opacity-70"
		parallax={0.4}
	/>
	<DecorativeCircle
		color="secondary"
		size={180}
		position="absolute right-[12%] top-[15%] -z-10"
		parallax={0.3}
	/>
	<DecorativeCircle
		color="primary"
		size={72}
		ring
		position="absolute left-[8%] bottom-[18%] -z-10"
		parallax={0.2}
	/>
	<Blob
		color="secondary"
		size={140}
		position="absolute left-[10%] top-[22%] -z-10"
		class="opacity-25"
		parallax={0.5}
	/>
	<Blob
		color="primary"
		size={120}
		position="absolute right-[14%] bottom-[24%] -z-10"
		class="opacity-10"
		parallax={0.35}
	/>

	<div class="mx-auto flex w-full max-w-content flex-col items-center gap-8 px-gutter pb-section pt-section">
		<h1 class="text-center font-display text-display text-ink">{hero.title}</h1>
		<p class="max-w-2xl text-center text-h3 text-ink/80">{hero.subtitle}</p>
	</div>
</section>