---
import { getCollection } from "astro:content";
import SectionTitle from "../ui/SectionTitle.astro";
import Wave from "../ui/Wave.astro";
import TopoWaves from "../ui/TopoWaves.astro";
import FlipCard from "../why-us/FlipCard.astro";

const reasons = (await getCollection("whyUs")).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<section
	id="por-que-elegirnos"
	class="relative scroll-mt-24 overflow-hidden bg-soft"
>
	<TopoWaves color="ink" class="absolute inset-0" />
	<div class="container-apside pb-[9rem] pt-section">
		<SectionTitle
			title="¿Por qué elegirnos?"
			subtitle="Lo que nos hace distintos"
			align="center"
		/>
		<ul
			class="mt-block grid grid-cols-1 gap-card md:grid-cols-2 lg:grid-cols-3"
			data-reveal-group
		>
			{reasons.map((reason) => (
				<li>
					<FlipCard
						title={reason.data.title}
						highlight={reason.data.highlight}
						description={reason.data.description}
					/>
				</li>
			))}
		</ul>
	</div>
	<Wave color="white" class="absolute inset-x-0 bottom-0" />
</section>