---
import { whyApside } from "../../content/sections/why-apside";
import Blob from "../ui/Blob.astro";
import DecorativeCircle from "../ui/DecorativeCircle.astro";
import Wave from "../ui/Wave.astro";
---

<section
	id="por-que-apside"
	class="relative scroll-mt-24 overflow-hidden"
>
	<Blob
		color="primary"
		size={380}
		position="absolute -right-24 top-1/2 -z-10"
		class="opacity-15"
		parallax={0.5}
	/>

	<div
		data-reveal
		class="container-apside grid grid-cols-1 items-center gap-10 pb-[9rem] pt-section md:grid-cols-[1.2fr_1fr] md:gap-16"
	>
		<div class="flex flex-col items-start gap-6">
			<h2 class="font-display text-h2 text-ink">{whyApside.title}</h2>
			<p class="max-w-xl text-body text-ink/80">{whyApside.description}</p>
			<ul class="flex flex-col gap-3">
				{
					whyApside.highlights.map((item) => (
						<li class="flex items-center gap-3">
							<span
								class="inline-block size-2 shrink-0 rounded-full bg-secondary"
								aria-hidden="true"
							></span>
							<span class="text-body font-medium text-ink">{item}</span>
						</li>
					))
				}
			</ul>
		</div>

		<div
			data-why-visual
			class="relative flex aspect-square w-full max-w-[260px] items-center justify-center justify-self-center rounded-card border-2 border-dashed border-primary/30 bg-white/60 sm:max-w-md"
			role="img"
			aria-label="Espacio reservado para la ilustración 3D"
		>
			<p class="relative px-4 text-center text-small text-ink/40">Ilustración 3D pendiente</p>
		</div>
	</div>

	<Wave color="ink" class="absolute inset-x-0 bottom-0" />
</section>

<script>
	import { gsap } from "../../scripts/gsap-init";

	const mm = gsap.matchMedia();

	mm.add("(prefers-reduced-motion: no-preference)", () => {
		const visual = document.querySelector<HTMLElement>("[data-why-visual]");
		if (!visual) return;

		gsap.to(visual, {
			y: -14,
			duration: 3,
			yoyo: true,
			repeat: -1,
			ease: "sine.inOut",
			delay: 1,
		});
	});
</script>