---
import { getCollection } from "astro:content";
import SectionTitle from "../ui/SectionTitle.astro";
import Wave from "../ui/Wave.astro";
import FaqItem from "../faq/FaqItem.astro";

const faqItems = (await getCollection("faq")).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<section id="faq" class="relative scroll-mt-24 overflow-hidden">
	<div class="container-apside pb-[9rem] pt-section">
		<SectionTitle
			title="Preguntas frecuentes"
			subtitle="Todo lo que necesitás saber antes de arrancar"
			align="center"
		/>
		<div class="mx-auto mt-block flex max-w-3xl flex-col gap-gutter" data-reveal-group>
			{faqItems.map((item) => (
				<FaqItem
					question={item.data.question}
					answer={item.data.answer}
				/>
			))}
		</div>
	</div>
	<Wave color="ink" class="absolute inset-x-0 bottom-0" />
</section>