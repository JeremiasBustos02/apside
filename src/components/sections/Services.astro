---
import { getCollection } from "astro:content";
import SectionTitle from "../ui/SectionTitle.astro";
import ServiceCard from "../services/ServiceCard.astro";

const services = (await getCollection("services")).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<section
	id="servicios"
	class="relative scroll-mt-24 overflow-hidden bg-primary/5"
>
	<div class="mx-auto max-w-content px-gutter pb-section pt-section">
		<SectionTitle
			title="Servicios"
			subtitle="Lo que hacemos para que tu negocio crezca"
			align="center"
		/>
		<div
			class="mt-block grid grid-cols-1 gap-card md:grid-cols-2 lg:grid-cols-3"
			data-reveal-group
		>
			{services.map((service) => (
				<ServiceCard
					title={service.data.title}
					summary={service.data.summary}
					forWhom={service.data.forWhom}
					problem={service.data.problem}
					includes={service.data.includes}
					improves={service.data.improves}
				/>
			))}
		</div>
	</div>
</section>