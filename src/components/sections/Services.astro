---
import { getCollection } from "astro:content";
import SectionTitle from "../ui/SectionTitle.astro";
import ServiceCard from "../services/ServiceCard.astro";
import Wave from "../ui/Wave.astro";

const services = (await getCollection("services")).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<section
	id="servicios"
	class="relative scroll-mt-24 "
>
	<div class="container-apside pb-section pt-section">
		<SectionTitle
			title="Servicios"
			subtitle="Lo que hacemos para que tu negocio crezca"
			align="center"
		/>
		<div
			class="mt-block grid grid-cols-1 items-start gap-card md:grid-cols-2 lg:grid-cols-3"
			data-reveal-group
		>
			{services.map((service) => (
				<ServiceCard
					title={service.data.title}
					summary={service.data.summary}
					forWhom={service.data.forWhom}
					problem={service.data.problem}
					improves={service.data.improves}
				/>
			))}
		</div>
	</div>
	<Wave
		color="primary"
		class="absolute inset-x-0 bottom-9 h-12 -scale-x-100 opacity-10"
	/>
	<Wave
		color="primary"
		class="absolute inset-x-0 -bottom-3 h-12 -scale-y-100 opacity-10"
	/>
</section>