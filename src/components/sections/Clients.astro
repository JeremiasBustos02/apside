---
import { getCollection } from "astro:content";
import SectionTitle from "../ui/SectionTitle.astro";
import Wave from "../ui/Wave.astro";
import Blob from "../ui/Blob.astro";
import DecorativeCircle from "../ui/DecorativeCircle.astro";
import ClientBadge from "../clients/ClientBadge.astro";

const clients = (await getCollection("clients")).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<section id="clientes" class="relative scroll-mt-24 overflow-hidden bg-ink">
	<Blob
		color="accent"
		size={200}
		class="absolute -right-24 top-1/4 opacity-10"
		parallax={0.5}
	/>
	<DecorativeCircle
		color="secondary"
		ring
		size={220}
		class="absolute -left-24 bottom-1/4 opacity-20"
		parallax={0.6}
	/>
	<div class="container-apside relative pb-section pt-section">
		<SectionTitle
			title="Clientes"
			subtitle="Confían en nosotros"
			align="left"
			tone="light"
		/>
		<ul
			class="mt-gutter grid grid-cols-1 gap-card sm:grid-cols-2 lg:grid-cols-4"
			data-reveal-group
		>
			{clients.map((client) => (
				<li class="h-full">
					<ClientBadge
						id={client.id}
						name={client.data.name}
						logo={client.data.logo}
						description={client.data.description}
						url={client.data.url}
					/>
				</li>
			))}
		</ul>
	</div>
	<Wave color="white" class="absolute inset-x-0 bottom-0" />
</section>