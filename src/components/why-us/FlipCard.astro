---
import Wave from "../ui/Wave.astro";

interface Props {
	title: string;
	highlight: string;
	description: string;
}

const { title, highlight, description } = Astro.props;
---

<div data-flip class="group relative h-[24rem] [perspective:1000px] sm:h-[26rem] lg:h-auto lg:aspect-[3/4] lg:[perspective:1200px]">
	<div
		class="flip-inner relative h-full w-full [transform-style:preserve-3d]"
		data-flip-inner
	>
		<button
			type="button"
			data-flip-toggle
			aria-label={`${title}: ${highlight}. Tocar para ver más`}
			class="absolute inset-0 flex h-full w-full flex-col items-center justify-center gap-4 overflow-hidden rounded-card border border-soft bg-white p-card text-center shadow-sm [backface-visibility:hidden] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
		>
			<Wave
				color="primary"
				flip
				class="absolute inset-x-0 top-0 h-12"
			/>
			<Wave
				color="primary"
				class="absolute inset-x-0 bottom-0 h-12"
			/>
			<span class="relative text-h3 font-display font-bold text-ink">{title}</span>
			<span class="relative max-w-sm text-body font-medium text-primary">
				{highlight}
			</span>
		</button>
		<div
			aria-hidden="true"
			class="absolute inset-0 flex h-full w-full flex-col items-center justify-center gap-4 rounded-card bg-primary p-card text-center shadow-sm [backface-visibility:hidden] [transform:rotateY(180deg)]"
		>
			<span class="text-h3 font-display font-bold text-white">{title}</span>
			<p class="max-w-sm text-body text-white/85">{description}</p>
		</div>
	</div>
</div>

<style>
	@media (prefers-reduced-motion: reduce) {
		.flip-inner[data-flipped="true"] {
			transform: rotateY(180deg);
		}
	}
</style>