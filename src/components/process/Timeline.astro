---
interface Step {
	step: number;
	title: string;
	short?: string;
	description: string;
}

interface Props {
	steps: Step[];
}

const { steps } = Astro.props;

const stepColors = [
	"var(--color-primary)",
	"var(--color-secondary)",
	"var(--color-ink)",
	"var(--color-primary)",
];

const icons = [
	`<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>`,
	`<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>`,
	`<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
	`<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
];
---

<div class="relative" data-process-pinned>
	<div
		class="process-layout relative lg:grid lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-x-16"
	>
		<div class="process-timeline relative lg:flex lg:flex-col">
			<div class="process-track" aria-hidden="true">
				<div class="process-fill" data-process-fill></div>
			</div>

			<ol
				class="process-steps relative z-10 lg:flex-1 lg:flex lg:flex-col lg:justify-between"
				aria-label="Etapas del proceso"
			>
				{steps.map((step, index) => (
					<li
						class="process-step flex items-center gap-6 py-8"
						style={`--step-color: ${stepColors[index % stepColors.length]}`}
						data-process-step
					>
						<span
							class="process-node flex size-12 shrink-0 items-center justify-center rounded-full border-2"
							data-process-node
							aria-hidden="true"
						>
							<Fragment set:html={icons[index % icons.length]} />
						</span>

						<div class="process-step-body">
							<h4 class="font-display text-h4 leading-tight text-ink">
								{step.title}
							</h4>
							<p class="mt-1.5 max-w-xs text-small leading-snug text-ink/60">
								{step.short ?? step.description}
							</p>
						</div>
					</li>
				))}
			</ol>
		</div>

		<div class="process-copy relative mt-12 lg:mt-0">
			{steps.map((step) => (
				<article
					class="process-copy-stage mt-12 first:mt-0"
					data-process-copy
				>
					<h2 class="font-display text-h2 text-ink">{step.title}</h2>
					<p class="mt-4 max-w-md text-ink/70">{step.description}</p>
				</article>
			))}
		</div>
	</div>
</div>

<style>
	.process-track {
		position: absolute;
		left: 1.5rem;
		top: 3.75rem;
		bottom: 3.75rem;
		width: 2px;
		transform: translateX(-50%);
		background-color: color-mix(in srgb, var(--color-ink) 14%, transparent);
	}

	.process-fill {
		position: absolute;
		inset: 0;
		transform-origin: top;
		transform: scaleY(1);
		background-color: var(--color-primary);
	}

	.process-node {
		border-color: var(--step-color);
		background-color: var(--step-color);
		color: #fff;
		transition: box-shadow 0.4s ease;
	}

	.process-live .process-fill {
		transform: scaleY(0);
	}

	.process-live .process-step,
	.process-live [data-process-copy] {
		opacity: 0;
		transform: translateY(1.25rem);
		transition:
			opacity 0.6s ease,
			transform 0.6s ease;
	}

	.process-live .process-step.is-visible,
	.process-live [data-process-copy].is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.process-live .process-step.is-active .process-node {
		box-shadow: 0 0 0 8px
			color-mix(in srgb, var(--step-color) 18%, transparent);
	}
</style>