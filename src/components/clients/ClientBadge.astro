---
interface Props {
	id: string;
	name: string;
	logo?: string;
	url: string;
}

const { id, name, logo, url } = Astro.props;

const initials = name
	.split(" ")
	.map((part) => part[0])
	.join("");
---

<a
	id={id}
	href={url}
	target="_blank"
	rel="noopener"
	class="group flex flex-col items-center justify-center gap-3 rounded-card border border-soft bg-white p-card text-center shadow-sm transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent hover:border-primary/30 hover:shadow-md"
>
	{logo ? (
		<img
			src={logo}
			alt=""
			width={72}
			height={72}
			loading="lazy"
			class="size-18 rounded-xl object-cover"
		/>
	) : (
		<div
			class="flex size-18 items-center justify-center rounded-xl bg-soft font-display text-h4 text-primary"
			aria-hidden="true"
		>
			{initials}
		</div>
	)}
	<div class="flex flex-col items-center">
		<p class="font-display text-h4 text-ink">{name}</p>
		<p
			class="flex items-center gap-1 text-small font-medium text-primary opacity-0 transition-opacity group-hover:opacity-100"
			aria-hidden="true"
		>
			<span>Visitar sitio</span>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="size-4"
			>
				<path d="M7 17 17 7" />
				<path d="M7 7h10v10" />
			</svg>
		</p>
	</div>
</a>